#include <iostream>
using namespace std;

class Employee
{
private:
    int id;
    string name;
    string department;
    float salary;

public:
    // Parameterized constructor
    Employee(int i, string n, string d, float s)
    {
        id = i;
        name = n;
        department = d;
        salary = s;

        cout << "Employee record created." << endl;
    }

    void display()
    {
        cout << "\nEmployee ID: " << id;
        cout << "\nName: " << name;
        cout << "\nDepartment: " << department;
        cout << "\nSalary: " << salary << endl;
    }

    // Destructor
    ~Employee()
    {
        cout << "\nEmployee record removed from memory." << endl;
    }
};

int main()
{
    Employee e1(101, "Rahul", "HR", 35000);
    Employee e2(102, "Priya", "IT", 45000);
    Employee e3(103, "Amit", "Finance", 40000);

    cout << "\n--- Employee Records ---" << endl;

    e1.display();
    e2.display();
    e3.display();

    cout << "\nProcessing completed." << endl;

    return 0;
}
